# Firebase Web config — copy from Firebase Console → Project → Web app (</>)
# Then copy this file to .env and fill in real values. Restart dev server after changes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin email notifications (server-only — no VITE_ prefix so keys never
# reach the browser). See firebasesetup.md "Email notifications" for setup.
# Two options, neither needs the client's passwords: your Gmail + App Password,
# or a free Brevo SMTP relay (SMTP_HOST=smtp-relay.brevo.com, PORT 587).
# Until set, forms still save to Firestore; only the notification emails
# are skipped.
ADMIN_EMAIL=Monikak@spgroupcorps.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: custom sender name/address. Defaults to SMTP_USER.
# SMTP_FROM=SP Securities Website <you@gmail.com>
