# Dependencies
node_modules/

# Build outputs (all generated — never commit)
dist/
.output/
.apphosting/
.netlify/
.firebase/
.vinxi/
build/
.tanstack/
.wrangler/

# Env (keep .env.example tracked, never commit real keys)
.env
.env.local
.env.*.local

# Logs / OS / TS cache
*.log
npm-debug.log*
*.tsbuildinfo
.DS_Store
# Stray office files must never be committed (they bloat every clone/deploy)
*.docx
*.xlsx
*.pptx

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

